# Copy to .env and fill in. Never commit the real .env (it's gitignored).

PORT=3000

# Signs session cookies. Must be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: fixes the seeded admin account's password on first run.
# Leave unset to get a random one printed to the server log instead.
#ADMIN_PASSWORD=
